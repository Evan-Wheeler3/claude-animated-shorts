{
  "name": "holdup-phil-bathroom",
  "private": true,
  "description": "Hold Up episode phil-bathroom: Three.js scenes rendered through Remotion (Absurd 3D Comedy style).",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --public-dir=../assets",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit",
    "animatic": "remotion render src/index.ts PhilShort ../../../out/phil-bathroom/animatic.mp4 --public-dir=../assets --width=360 --height=640 --codec=h264 --crf=26",
    "final": "remotion render src/index.ts PhilShort ../../../out/phil-bathroom/video.mp4 --public-dir=../assets --width=1440 --height=2560 --codec=h264 --crf=16 --gl=angle"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.545",
    "three": "0.177.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/three": "0.177.0",
    "typescript": "5.8.3"
  }
}
