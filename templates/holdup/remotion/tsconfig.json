{
 "compilerOptions": {
  "target": "ES2020",
  "module": "ESNext",
  "moduleResolution": "bundler",
  "jsx": "react-jsx",
  "strict": true,
  "skipLibCheck": true,
  "allowJs": true,
  "noEmit": true,
  "esModuleInterop": true,
  "baseUrl": ".",
  "paths": {
   "three": [
    "./node_modules/@types/three"
   ],
   "three/*": [
    "./node_modules/@types/three/*"
   ],
   "postprocessing": [
    "./node_modules/postprocessing"
   ],
   "*": [
    "./node_modules/*",
    "./node_modules/@types/*"
   ]
  },
  "resolveJsonModule": true
 },
 "include": [
  "src",
  "../../bridge/ink.ts",
  "../../bridge/toon.ts"
 ]
}